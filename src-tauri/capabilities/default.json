{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: the app's own commands (tunnels, keep running in the tray or quit), listening for the close request, and reading/setting the window size to fit the details panel (and the screen width)",
  "windows": ["main"],
  "permissions": [
    "allow-share",
    "allow-join",
    "allow-stop",
    "allow-list",
    "allow-hide",
    "allow-quit",
    "allow-tray-labels",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-current-monitor",
    "core:window:allow-set-size"
  ]
}
